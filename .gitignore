# Frontend
frontend/node_modules/
frontend/.expo/
frontend/dist/
frontend/.env
frontend/.env.local
frontend/.env.*.local
frontend/web-build/
frontend/ios/
frontend/android/

# Backend
backend/uploads/
backend/error.log
backend/vendor/

# Backend database dumps (contain real user data / password hashes — NEVER commit).
# This blanket rule is aimed at current.sql and backup_before_reset_*.sql.
backend/database/*.sql
# ...except these, which are pure DDL or fake data — no PII, and losing them
# would mean losing the ability to stand the database up again.
# (Keep each pattern on its own line — git has no trailing-comment syntax.)
# Reference data: categories / jobs / skills / languages
!backend/database/ref_seed.sql
# Table structure only, zero INSERTs
!backend/database/schema.sql
# ALTER/CREATE only, zero INSERTs
!backend/database/migration_*.sql
# Fake @carelink-demo.test accounts for user testing
!backend/database/demo_seed.sql

# Internal working notes — NOT for the public repo (security posture / stale guides)
/SECURITY_NOTES_*.md
/GUIDE_didit_valid_id_verification.md

# User-uploaded content (chat attachments, etc.)
uploads/
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp
*.swo
*~
frontend/.cursor/
.claude/settings.local.json

# OS
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.log

# Environment variables (NEVER commit these!)
.env
.env.local
.env.*.local



# Portable host config (DB creds + API key) — NEVER commit
backend/config.local.php

# Local email debug tool — must never reach the server
backend/test_email.php

# Temporary Hostinger SMTP diagnostic — upload manually, delete after use
backend/test_mail_config.php
backend/test_resend_debug.php

# Claude Code local permission allowlist — machine-specific paths, not shareable
.claude/settings.json

# Local one-time backfill artifact (not needed in the repo)
backend/database/job_titles_before_backfill.json

# Pre-filled Postman env — contains real account ids and a password. Never commit.
docs/postman/*.local.json

# Generated by tools/schema-diff.php — schema fixes for one machine at one moment.
# Regenerate rather than commit; a stale one applied later is a wrong migration.
tools/out/
