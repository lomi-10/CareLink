{
  "info": {
    "_postman_id": "carelink-api-collection",
    "name": "CareLink API",
    "description": "CareLink backend, grouped by what you would actually test.\n\nSETUP\n1. Import CareLink.postman_environment.json too, and select it (top-right dropdown).\n2. Fill in the ids for your own database — the environment file lists which.\n3. Run \"1 - Auth > Login\" first. It saves auth_token and user_id automatically.\n\nREADING THE RESULTS\nThis API answers with HTTP 200 and a JSON body of {success: true|false, message}.\nSo a refusal is a 200, not a 401. The tests assert on `success`, not the status\ncode — anything in \"2 - Security checks\" PASSES when the request is refused.\n\nRequests marked destructive really change data. Read before sending.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{auth_token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Warn once if the environment has not been filled in.",
          "if (!pm.environment.get('base_url')) {",
          "  console.warn('base_url is empty — select the CareLink environment (top-right dropdown).');",
          "}"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost/carelink_api"
    }
  ],
  "item": [
    {
      "name": "1 · Auth",
      "description": "Start here. Login writes {{auth_token}} and {{user_id}} into the environment automatically, so every later request is already signed in.",
      "item": [
        {
          "name": "Login (helper or employer)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/login.php",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "login.php"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{helper_email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "On success the test script saves auth_token and user_id to the environment."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('is JSON', () => pm.response.to.be.json);",
                  "const j = pm.response.json();",
                  "if (j.success && j.user) {",
                  "  pm.environment.set('user_id', j.user.user_id);",
                  "  if (j.auth_token) pm.environment.set('auth_token', j.auth_token);",
                  "  pm.test('token issued', () => pm.expect(j.auth_token, 'auth_token missing — AUTH_STRICT will fail').to.be.a('string'));",
                  "} else {",
                  "  pm.test('login failed: ' + (j.message || 'unknown'), () => pm.expect(j.success).to.eql(true));",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login — wrong password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/login.php",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "login.php"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{helper_email}}\",\n  \"password\": \"definitely-wrong\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Should refuse. Confirms the account is not accepting any password."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const status = pm.response.code;",
                  "let body = null; try { body = pm.response.json(); } catch (e) {}",
                  "pm.test('request was refused', () => {",
                  "  const refused = status === 401 || status === 403 || (status === 200 && body && body.success === false);",
                  "  pm.expect(refused, 'expected a refusal, got ' + status + ' ' + JSON.stringify(body)).to.eql(true);",
                  "});",
                  "pm.test('refusal explains itself', () => {",
                  "  pm.expect(body && body.message, 'no message in the refusal').to.be.a('string').and.not.empty;",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
