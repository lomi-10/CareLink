{
  "id": "carelink-live-env",
  "name": "CareLink — live (Hostinger)",
  "values": [
    {
      "key": "base_url",
      "value": "https://api.carelink-ph.com/carelink_api",
      "enabled": true,
      "type": "default",
      "description": "The deployed API root. api.carelink-ph.com is a subdomain pointing at .../public_html/api/, so the URL does NOT mirror the FTP path in the deploy workflow — it has no /api/ segment. Change it if the domain moves."
    },
    {
      "key": "helper_email",
      "value": "helper@carelink.test",
      "enabled": true,
      "type": "default"
    },
    {
      "key": "password",
      "value": "",
      "enabled": true,
      "type": "secret",
      "description": "Left blank on purpose — passwords do not belong in a committed file. The seeded value is in docs/reset-live-for-testing.sql."
    },
    {
      "key": "employer_email",
      "value": "employer@carelink.test",
      "enabled": true,
      "type": "default"
    },
    {
      "key": "employer_password",
      "value": "",
      "enabled": true,
      "type": "secret",
      "description": "Same password as above."
    },
    {
      "key": "auth_token",
      "value": "",
      "enabled": true,
      "type": "secret",
      "description": "Written automatically by the Login request. Leave blank."
    },
    {
      "key": "user_id",
      "value": "",
      "enabled": true,
      "type": "default",
      "description": "Written automatically by the Login request. Leave blank."
    },
    {
      "key": "other_user_id",
      "value": "4",
      "enabled": true,
      "type": "default",
      "description": "An account that is NOT the logged-in helper. The security checks ask for this user's private documents and must be refused."
    },
    {
      "key": "employer_id",
      "value": "4",
      "enabled": true,
      "type": "default"
    },
    {
      "key": "peso_user_id",
      "value": "1",
      "enabled": true,
      "type": "default"
    },
    {
      "key": "admin_user_id",
      "value": "2",
      "enabled": true,
      "type": "default"
    },
    {
      "key": "job_post_id",
      "value": "",
      "enabled": true,
      "type": "default",
      "description": "Fill in after the employer posts a job — a freshly seeded database has none."
    },
    {
      "key": "interview_id",
      "value": "",
      "enabled": true,
      "type": "default",
      "description": "Fill in once an interview exists."
    },
    {
      "key": "complaint_id",
      "value": "",
      "enabled": true,
      "type": "default",
      "description": "Fill in once a complaint exists."
    }
  ],
